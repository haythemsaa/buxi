# -----------------------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------------------
APP_NAME="Boxibox"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://boxibox.fr
APP_TIMEZONE=Europe/Paris

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=boxibox_production
DB_USERNAME=boxibox_user
DB_PASSWORD=

# -----------------------------------------------------------------------------
# SESSION & CACHE
# -----------------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.boxibox.fr

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

# -----------------------------------------------------------------------------
# REDIS
# -----------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# MAIL CONFIGURATION
# Production: Use SMTP (Mailgun, SendGrid, SES) or API
# Development: Use log or mailtrap
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@boxibox.fr"
MAIL_FROM_NAME="${APP_NAME}"

# Mailgun API (alternative to SMTP)
# MAILGUN_DOMAIN=mg.boxibox.fr
# MAILGUN_SECRET=
# MAILGUN_ENDPOINT=api.eu.mailgun.net

# -----------------------------------------------------------------------------
# MULTI-TENANCY SETTINGS
# -----------------------------------------------------------------------------
TENANCY_DATABASE_PREFIX=tenant_
TENANCY_DATABASE_AUTO_CREATE=true
TENANCY_DATABASE_AUTO_DELETE=false

# -----------------------------------------------------------------------------
# SANCTUM (API Authentication)
# -----------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=boxibox.fr,api.boxibox.fr
SANCTUM_GUARD=web

# -----------------------------------------------------------------------------
# CORS SETTINGS
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://boxibox.fr,https://api.boxibox.fr
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With

# -----------------------------------------------------------------------------
# AWS S3 (For file storage - optional)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# PAYMENT GATEWAY CONFIGURATION
# -----------------------------------------------------------------------------
# Stripe (Primary payment gateway)
STRIPE_KEY=pk_live_YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_SECRET=sk_live_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# PayPal (Alternative payment gateway)
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID
PAYPAL_SECRET=YOUR_PAYPAL_SECRET_KEY
PAYPAL_WEBHOOK_ID=YOUR_PAYPAL_WEBHOOK_ID

# SEPA (European Direct Debit)
SEPA_ENABLED=true
SEPA_CREDITOR_ID=YOUR_SEPA_CREDITOR_ID
SEPA_CREDITOR_NAME="Boxibox SAS"
SEPA_MANDATE_REFERENCE_PREFIX=BOX

# -----------------------------------------------------------------------------
# PUSH NOTIFICATIONS (Firebase Cloud Messaging)
# -----------------------------------------------------------------------------
FCM_SERVER_KEY=
FCM_SENDER_ID=

# APNS (Apple Push Notification Service)
# APNS_CERTIFICATE_PATH=
# APNS_CERTIFICATE_PASSPHRASE=
# APNS_ENVIRONMENT=production

# -----------------------------------------------------------------------------
# SMS GATEWAY (For 2FA and alerts - optional)
# -----------------------------------------------------------------------------
# Twilio
# TWILIO_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# OVH SMS (alternative)
# OVH_SMS_ACCOUNT=
# OVH_SMS_LOGIN=
# OVH_SMS_PASSWORD=

# -----------------------------------------------------------------------------
# BUSINESS SETTINGS
# -----------------------------------------------------------------------------
# Default tax rate (TVA in France: 20%)
DEFAULT_TAX_RATE=20.00

# Late payment fees percentages per phase
PAYMENT_REMINDER_PHASE_1_FEE=0
PAYMENT_REMINDER_PHASE_2_FEE=5
PAYMENT_REMINDER_PHASE_3_FEE=10

# Reminder schedule (days after due date)
PAYMENT_REMINDER_PHASE_1_DAYS=7
PAYMENT_REMINDER_PHASE_2_DAYS=15
PAYMENT_REMINDER_PHASE_3_DAYS=30

# Reservation settings
RESERVATION_VALIDITY_DAYS=30
RESERVATION_AUTO_CANCEL_EXPIRED=true

# Loyalty program
LOYALTY_POINTS_PER_CONTRACT=100
LOYALTY_POINTS_PER_PAYMENT=10
LOYALTY_POINTS_PER_REFERRAL=50
LOYALTY_POINTS_EXPIRY_MONTHS=12

# Promotion settings
PROMOTION_AUTO_APPLY=true
PROMOTION_STACKABLE_DEFAULT=false

# -----------------------------------------------------------------------------
# SCHEDULER SETTINGS
# -----------------------------------------------------------------------------
# Payment reminders
SCHEDULER_PAYMENT_REMINDERS_ENABLED=true
SCHEDULER_PAYMENT_REMINDERS_TIME=10:00
SCHEDULER_PAYMENT_REMINDERS_TIMEZONE=Europe/Paris

# Auto-cancel expired reservations
SCHEDULER_AUTO_CANCEL_RESERVATIONS=true

# Loyalty points expiration check
SCHEDULER_LOYALTY_EXPIRY_CHECK=true

# -----------------------------------------------------------------------------
# SECURITY SETTINGS
# -----------------------------------------------------------------------------
# Rate limiting
RATE_LIMIT_API=60
RATE_LIMIT_LOGIN=5

# Password requirements
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL_CHARS=false

# Session security
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# -----------------------------------------------------------------------------
# MONITORING & ANALYTICS (optional)
# -----------------------------------------------------------------------------
# Sentry (Error tracking)
# SENTRY_LARAVEL_DSN=
# SENTRY_TRACES_SAMPLE_RATE=1.0

# Google Analytics
# GOOGLE_ANALYTICS_ID=

# -----------------------------------------------------------------------------
# BACKUP SETTINGS
# -----------------------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_DISK=local
BACKUP_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# VITE (Frontend build tool)
# -----------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
VITE_APP_URL="${APP_URL}"
VITE_API_URL="${APP_URL}/api/v1"
VITE_STRIPE_KEY="${STRIPE_KEY}"
