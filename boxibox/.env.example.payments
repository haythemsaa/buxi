# ================================
# PAYMENT GATEWAYS CONFIGURATION
# ================================

# Default Gateway (stripe, paypal, sepa)
PAYMENT_DEFAULT_GATEWAY=stripe
PAYMENT_FALLBACK_ENABLED=true
PAYMENT_FALLBACK_GATEWAY=sepa

# Stripe Configuration
STRIPE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_CURRENCY=eur

# PayPal Configuration
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_SECRET=your_paypal_secret_here
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=EUR

# SEPA Configuration (existing)
SEPA_CREDITOR_ID=your_creditor_id
SEPA_CREDITOR_NAME=Boxibox
SEPA_CREDITOR_IBAN=FR76XXXXXXXXXXXXXXXXXX
SEPA_CREDITOR_BIC=BNPAFRPP

# 3D Secure
PAYMENT_3D_SECURE_ENABLED=true
PAYMENT_3D_SECURE_THRESHOLD=30

# Enabled Payment Methods
PAYMENT_METHOD_CARD=true
PAYMENT_METHOD_PAYPAL=true
PAYMENT_METHOD_SEPA=true
PAYMENT_METHOD_APPLE_PAY=true
PAYMENT_METHOD_GOOGLE_PAY=true
